(load "Test.carp")
(use Test)
(load "ringbuf.carp")
(use RingBuf)

(deftest ringbuf-test
  (let [rb (RingBuf.new 3 0)]
    (let [s1 (assert-equal ringbuf-test 0 (RingBuf.length &rb) "initially empty")
          s2 (assert-true &s1 (RingBuf.empty? &rb) "empty? is true")
          
          _1 (RingBuf.push! &rb 1)
          _2 (RingBuf.push! &rb 2)
          s3 (assert-equal &s2 2 (RingBuf.length &rb) "length after 2 pushes")
          
          _3 (RingBuf.push! &rb 3)
          s4 (assert-true &s3 (RingBuf.full? &rb) "full after 3 pushes")
          
          _4 (RingBuf.push! &rb 4)
          s5 (assert-equal &s4 3 (RingBuf.length &rb) "length remains capacity after overflow")
          
          p1 (RingBuf.pop! &rb)
          s6 (assert-equal &s5 &(Maybe.Just 2) &p1 "first element after overflow (should be 2 because 1 was overwritten)")
          
          p2 (RingBuf.pop! &rb)
          s7 (assert-equal &s6 &(Maybe.Just 3) &p2 "second element")
          
          p3 (RingBuf.pop! &rb)
          s8 (assert-equal &s7 &(Maybe.Just 4) &p3 "third element")
          
          s9 (assert-true &s8 (RingBuf.empty? &rb) "empty after popping all")
          
          _5 (RingBuf.push! &rb 5)
          pk (RingBuf.peek &rb)
          s10 (assert-equal &s9 &(Maybe.Just 5) &pk "peek works")
          
          arr (RingBuf.to-array &rb)
          s11 (assert-equal &s10 1 (Array.length &arr) "to-array length")
          s12 (assert-equal &s11 5 @(Array.unsafe-nth &arr 0) "to-array content")
          
          _6 (RingBuf.clear! &rb)
          s13 (assert-true &s12 (RingBuf.empty? &rb) "empty after clear")
          ]
      s13)))
