(doc RingBuf "is a generic fixed-capacity circular buffer.")
(deftype (RingBuf t) [
  data (Array t)
  head-idx Int
  tail-idx Int
  n-elements Int
  max-cap Int
])

(defmodule RingBuf
  (doc new "creates a new RingBuf with a fixed capacity. Requires a default value to initialize the underlying array.")
  (defn new [capacity default-val]
    (RingBuf.init (Array.replicate capacity &default-val) 0 0 0 capacity))

  (doc length "returns the number of elements currently in the buffer.")
  (defn length [rb]
    @(RingBuf.n-elements rb))

  (doc capacity "returns the total capacity of the buffer.")
  (defn capacity [rb]
    @(RingBuf.max-cap rb))

  (doc empty? "checks whether the buffer is empty.")
  (defn empty? [rb]
    (Int.= @(RingBuf.n-elements rb) 0))

  (doc full? "checks whether the buffer is full.")
  (defn full? [rb]
    (Int.= @(RingBuf.n-elements rb) @(RingBuf.max-cap rb)))

  (doc push! "inserts a value into the buffer. If the buffer is full, it overwrites the oldest element and advances the head.")
  (defn push! [rb val]
    (let [cap @(RingBuf.max-cap rb)
          t @(RingBuf.tail-idx rb)
          h @(RingBuf.head-idx rb)
          s @(RingBuf.n-elements rb)]
      (do
        (Array.aset! (RingBuf.data rb) t val)
        (RingBuf.set-tail-idx! rb (Int.mod (Int.inc t) cap))
        (if (Int.= s cap)
            (RingBuf.set-head-idx! rb (Int.mod (Int.inc h) cap))
            (RingBuf.set-n-elements! rb (Int.inc s))))))

  (doc pop! "removes and returns the oldest element from the buffer, wrapped in a Maybe.")
  (defn pop! [rb]
    (if (RingBuf.empty? rb)
      (Maybe.Nothing)
      (let [cap @(RingBuf.max-cap rb)
            h @(RingBuf.head-idx rb)
            s @(RingBuf.n-elements rb)
            val @(Array.unsafe-nth (RingBuf.data rb) h)]
        (do
          (RingBuf.set-head-idx! rb (Int.mod (Int.inc h) cap))
          (RingBuf.set-n-elements! rb (Int.dec s))
          (Maybe.Just val)))))

  (doc peek "returns a copy of the oldest element in the buffer, wrapped in a Maybe.")
  (defn peek [rb]
    (if (RingBuf.empty? rb)
      (Maybe.Nothing)
      (Maybe.Just @(Array.unsafe-nth (RingBuf.data rb) @(RingBuf.head-idx rb)))))

  (doc clear! "removes all elements from the buffer.")
  (defn clear! [rb]
    (do
      (RingBuf.set-head-idx! rb 0)
      (RingBuf.set-tail-idx! rb 0)
      (RingBuf.set-n-elements! rb 0)))

  (doc to-array "returns a new array containing the elements of the buffer in order.")
  (defn to-array [rb]
    (let [s @(RingBuf.n-elements rb)
          cap @(RingBuf.max-cap rb)
          h @(RingBuf.head-idx rb)
          arr (Array.allocate s)]
      (do
        (for [i 0 s]
          (Array.aset! &arr i @(Array.unsafe-nth (RingBuf.data rb) (Int.mod (Int.+ h i) cap))))
        arr)))
)
